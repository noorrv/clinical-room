# Copy this file to .env.local and fill in the two values from
# Supabase → Project Settings → API (or "API Keys").
# Only the public key belongs here. NEVER put the service_role / secret key in this project.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
